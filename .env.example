# Django 安全配置 — 复制此文件为 .env 并填入实际值
# .env 已在 .gitignore 中排除，不会被提交到 Git

# Django 密钥（必填，请用 python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())" 生成）
DJANGO_SECRET_KEY=your-secret-key-here

# 调试模式（生产环境设为 False）
DEBUG=True

# 允许的域名（逗号分隔，生产环境填入实际域名）
ALLOWED_HOSTS=localhost,127.0.0.1
